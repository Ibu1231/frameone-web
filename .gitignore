# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# source masters — camera/edit exports kept locally for re-encoding.
# These are far too large for git (GitHub rejects >100MB) and must never
# be served: anything in /public is copied verbatim into the export.
/assets-source

# Per-genre folders under /public/videos hold delivery masters dropped in
# for encoding (hundreds of MB each). Only the flat, web-encoded files
# beside them — hero-1080.mp4 and the like — belong in the repo.
/public/videos/*/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
