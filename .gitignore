# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# source masters — camera/edit exports kept locally for re-encoding.
# These are far too large for git (GitHub rejects >100MB) and must never
# be served: anything in /public is copied verbatim into the export.
/assets-source

# Camera/edit masters must never be committed or deployed. This ignores
# them by container rather than by folder: the previous rule ignored all
# of /public/videos/<genre>/, which silently excluded the web encodes
# living there too, so the built site shipped without them.
# Web-ready .mp4 under /public/videos IS tracked.
*.mov
*.MOV
*.mxf
*.MXF
*.mkv
*.avi
/public/videos/**/*-master.mp4

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
